OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=mock

# Short-drama text generation stays offline unless explicitly changed.
DRAMA_MODEL=mock

# Character image generation. Keep the model empty for local placeholder PNGs;
# a real run must still pass the multimodal runner's per-run authorization.
AI_DRAW_API_KEY=
AI_DRAW_BASE_URL=
AI_DRAW_MODEL=

# Seedance-compatible video service defaults. The API key and a public HTTPS
# callback base are intentionally left empty; without both, no real video can
# be submitted. SD_VIDEO_MODE=mock is the safe default.
SD_VIDEO_MODE=mock
SD_API_KEY=
SD_API_BASE_URL=https://model.service-inference.ai
SD_VIDEO_MODEL=dreamina-seedance-2-0-hc
SD_ASSET_PUBLIC_BASE_URL=
SD_VIDEO_RESULT_HOSTS=
SD_VIDEO_ESTIMATED_COST_CNY=
